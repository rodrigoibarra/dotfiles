#!/usr/bin/env sh
# ~/.config/sketchybar/sketchybarrc
# Thin top bar: app + space on the left, glanceable widgets on the right.

source "$HOME/.config/sketchybar/colors.sh"

ITEM_DIR="$HOME/.config/sketchybar/items"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

FONT="Hack Nerd Font"
PADDINGS=4

# --- Bar appearance ---
sketchybar --bar height=28 \
                 color="$BAR_COLOR" \
                 position=top \
                 sticky=on \
                 padding_left=10 \
                 padding_right=10 \
                 corner_radius=0 \
                 y_offset=0 \
                 blur_radius=20 \
                 shadow=off \
    --default updates=when_shown \
                 icon.font="$FONT:Bold:14.0" \
                 icon.color="$TEXT_COLOR" \
                 icon.padding_left=$PADDINGS \
                 icon.padding_right=6 \
                 label.font="$FONT:Semibold:13.0" \
                 label.color="$TEXT_COLOR" \
                 label.padding_left=2 \
                 label.padding_right=$PADDINGS \
                 background.padding_left=2 \
                 background.padding_right=2

# --- Left: active app, active space (no picker) ---
source "$ITEM_DIR/front_app.sh"
source "$ITEM_DIR/active_space.sh"

# --- Right: clock, next todoist task, next calendar event, now playing ---
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/todoist.sh"
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/nowplaying.sh"

sketchybar --update
echo "sketchybar configuration loaded.."
